# Copy to .env and fill in real values.

# Billetto API key pair. Create one at https://api.billetto.com (account settings).
BILLETTO_API_KEYPAIR=

# Clerk keys. Create an application at https://dashboard.clerk.com.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Optional overrides.
BILLETTO_API_BASE_URL=https://billetto.dk/api/v3

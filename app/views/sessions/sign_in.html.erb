<% content_for :title, "Sign in" %>

<main class="auth">
  <h1>Sign in</h1>
  <div id="clerk-sign-in"
       data-controller="clerk-auth"
       data-clerk-auth-mode-value="sign_in"
       data-clerk-auth-redirect-url-value="<%= root_path %>"></div>
  <p class="auth__hint">
    No account? <%= link_to "Sign up", sign_up_path %>.
  </p>
</main>

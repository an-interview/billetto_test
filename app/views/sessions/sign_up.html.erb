<% content_for :title, "Sign up" %>

<main class="auth">
  <h1>Sign up</h1>
  <div id="clerk-sign-up"
       data-controller="clerk-auth"
       data-clerk-auth-mode-value="sign_up"
       data-clerk-auth-redirect-url-value="<%= root_url %>"></div>
  <p class="auth__hint">
    Already have an account? <%= link_to "Sign in", sign_in_path %>.
  </p>
</main>
